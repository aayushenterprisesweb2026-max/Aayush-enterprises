RewriteEngine On
RewriteBase /

# Serve existing files and directories directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Allow API routes to pass through if this host is ever served through Apache.
RewriteRule ^api/ - [L]

# Fallback all other routes to the SPA entry point.
RewriteRule ^ index.html [L]
